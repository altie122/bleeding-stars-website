---
import { format } from "date-fns";
import { resolveCoverImage } from "~/content/blog/_resolveImages.js";

export type Props = {
	post: {
		slug: string;
		data: {
			title: string;
			description: string;
			publishDate: Date;
			coverImage?: string;
			important?: boolean;
		};
	};
};

const { post } = Astro.props;

const image = await resolveCoverImage(post);
---

<article
	class={"border p-4 transition-transform duration-300 ease-out focus-within:outline hover:scale-[1.03] rounded-lg" + (post.data.important ? " bg-red-700" : "bg-secondary")}
>
	<a
		href={`/meetings/${post.slug}/`}
		data-astro-prefetch
		class="block outline-none"
	>
		<header>
			<time datetime={post.data.publishDate.toISOString()}>
				{format(post.data.publishDate, "MMMM d, yyyy")}
			</time>
		</header>
		<div class="-mx-4">
			{
				image && (
					<img
						src={image.src}
						width={image.width}
						height={image.height}
						alt={post.data.title}
						class="my-4"
						loading="lazy"
						decoding="async"
					/>
				)
			}
		</div>

		<div class="mt-6 grid gap-x-16 gap-y-4 md:grid-cols-2">
			<h3 class="text-lg sm:text-xl lg:text-2xl text-secondary-foreground">{post.data.title}</h3>
			<p class="text-secondary-foreground">{post.data.description}</p>
		</div></a
	>
</article>